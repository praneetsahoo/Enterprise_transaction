# Copy to .env for local development. Never commit .env.

# Local MySQL 8 for development/tests
DB_URL=mysql+pymysql://payrecon_app:CHANGE_ME@127.0.0.1:3306/payrecon

# On AWS these are set by the deployment instead (no password in any file):
# DB_HOST=payrecon-db.xxxxxxxx.ap-southeast-2.rds.amazonaws.com
# DB_PASSWORD_PARAM=/payrecon/db/app_password
# S3_BUCKET=payrecon-data-<account-id>
AWS_REGION=ap-southeast-2
