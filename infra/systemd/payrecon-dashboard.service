# PayRecon Streamlit dashboard — installed by infra/deploy.sh
[Unit]
Description=PayRecon dashboard (Streamlit)
After=network-online.target
Wants=network-online.target

[Service]
User=payrecon
Group=payrecon
WorkingDirectory=/opt/payrecon/app
EnvironmentFile=/etc/payrecon/payrecon.env
Environment=HOME=/var/lib/payrecon
ExecStart=/opt/payrecon/venv/bin/streamlit run app/dashboard.py --server.port 80 --server.address 0.0.0.0
Restart=on-failure
RestartSec=5
# bind port 80 without running as root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
StandardOutput=append:/var/log/payrecon/dashboard.log
StandardError=append:/var/log/payrecon/dashboard.log

[Install]
WantedBy=multi-user.target
